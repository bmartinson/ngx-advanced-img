{
  "name": "ngx-advanced-img-sample",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prep-release": "./scripts/bump-package-version.sh ngx-advanced-img",
    "build": "ng build ngx-advanced-img --configuration production",
    "build-publish": "./scripts/build-publish.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "npx prettier --write . $@",
    "lint": "ng lint --fix ngx-advanced-img-sample; ng lint --fix ngx-advanced-img"
  },
  "private": false,
  "license": "MIT",
  "author": "Brian Martinson <brian@brianmartinson.com> (https://brianmartinson.com/)",
  "description": "An Angular directive library for advanced img feature extensions.",
  "keywords": [
    "angular",
    "img",
    "fallback",
    "progressive",
    "loader",
    "ng",
    "ng2",
    "ngx"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bmartinson/ngx-advanced-img.git"
  },
  "bugs": {
    "url": "https://github.com/bmartinson/ngx-advanced-img/issues",
    "email": "brian@brianmartinson.com"
  },
  "homepage": "https://github.com/bmartinson/ngx-advanced-img#readme",
  "overrides": {
    "body-parser": "^1.20.6",
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@xmldom/xmldom": "~0.9.12",
    "exifreader": "^4.50.0",
    "libheif-js": "^1.23.5",
    "mime": "^4.1.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^14.0.3",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "~22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.6.0",
    "baseline-browser-mapping": "^2.11.30",
    "eslint": "^10.13.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
